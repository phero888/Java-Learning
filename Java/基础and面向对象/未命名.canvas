			"width":192,
			"height":41
		},
		{
			"id":"5b68b651d212f3d6",
			"type":"text",
			"text":"```java\nclass Dog implements Animal\n```",
			"styleAttributes":{"border":"invisible"},
			"x":166,
			"y":-30,
			"width":192,
			"height":52
		},
		{
			"id":"69d0a2fc229b4512",
			"type":"text",
			"text":"- 向上转型\n`Animal a = new Dog();`",
			"styleAttributes":{"border":"invisible"},
			"x":177,
			"y":75,
			"width":153,
			"height":34
		},
		{
			"id":"9cd43fc6ce234653",
			"type":"text",
			"text":"- ==向下强转==\n\t`Dog d = (Dog) a;`",
			"styleAttributes":{"border":"invisible"},
			"x":177,
			"y":167,
			"width":153,
			"height":34
		},
		{
			"id":"b1c00ee03695d2b8",
			"type":"text",
			"text":">- 高可维护性\n>- 强可扩展性",
			"styleAttributes":{"border":"invisible","textAlign":"center"},
			"x":-21,
			"y":78,
			"width":122,
			"height":47
		},
		{
			"id":"b3c58d82cd181431",
			"type":"text",
			"text":">- 父类不能使用子类特有属性",
			"styleAttributes":{"border":"invisible","textAlign":"center"},
			"x":-21,
			"y":123,
			"width":122,
			"height":46
		},
		{
